{
  "name": "logscope",
  "description": "nginx log viewer",
  "packageManager": "bun@1.3.9",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "turbo run dev --filter=@logscope/web",
    "dev:api": "turbo run dev --filter=@logscope/api",
    "dev": "turbo dev",
    "test:web": "turbo run test --filter=@logscope/web",
    "test:api": "turbo run test --filter=@logscope/api",
    "test": "turbo test",
    "build": "turbo build",
    "lint": "biome lint --write",
    "format": "biome format --write",
    "check": "biome check --write",
    "release": "semantic-release",
    "prepare": "husky"
  },
  "author": "Dino Kupinic",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "catalog:linting",
    "@semantic-release/changelog": "catalog:release",
    "@semantic-release/commit-analyzer": "catalog:release",
    "@semantic-release/git": "catalog:release",
    "@semantic-release/github": "catalog:release",
    "@semantic-release/release-notes-generator": "catalog:release",
    "husky": "catalog:git-hooks",
    "lint-staged": "catalog:git-hooks",
    "semantic-release": "catalog:release",
    "turbo": "^2.9.7"
  },
  "catalogs": {
    "react": {
      "react": "^19.2.4",
      "react-dom": "^19.2.4",
      "@types/react": "^19.2.10",
      "@types/react-dom": "^19.2.3"
    },
    "react-router": {
      "react-router": "7.12.0",
      "@react-router/node": "7.12.0",
      "@react-router/serve": "7.12.0",
      "@react-router/dev": "7.12.0"
    },
    "tailwind": {
      "tailwindcss": "^4.1.18",
      "@tailwindcss/vite": "^4.1.18",
      "tailwind-merge": "^3.5.0",
      "tw-animate-css": "^1.4.0"
    },
    "icons": {
      "@hugeicons/core-free-icons": "^4.0.0",
      "@hugeicons/react": "^1.1.6",
      "@remixicon/react": "^4.9.0"
    },
    "ui": {
      "@base-ui/react": "^1.3.0",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "radix-ui": "^1.4.3",
      "shadcn": "^4.0.8"
    },
    "fonts": {
      "@fontsource-variable/outfit": "^5.2.8",
      "@fontsource-variable/public-sans": "^5.2.7"
    },
    "typescript": {
      "typescript": "^5.9.3",
      "@types/node": "^25.1.0",
      "@types/bun": "latest",
      "vite-tsconfig-paths": "^5.1.4"
    },
    "vite": {
      "vite": "^7.2.4"
    },
    "tooling": {
      "turbo": "^2.8.17",
      "@turbo/gen": "^2.8.1"
    },
    "linting": {
      "@biomejs/biome": "^2.4.7"
    },
    "git-hooks": {
      "husky": "^9.1.7",
      "lint-staged": "^16.2.7"
    },
    "release": {
      "semantic-release": "^25.0.3",
      "@semantic-release/changelog": "^6.0.3",
      "@semantic-release/commit-analyzer": "^13.0.1",
      "@semantic-release/git": "^10.0.1",
      "@semantic-release/github": "^12.0.6",
      "@semantic-release/release-notes-generator": "^14.1.0"
    },
    "validation": {
      "zod": "^3.25.76"
    },
    "utils": {
      "isbot": "^5.1.31"
    }
  }
}
