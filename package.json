{
  "name": "logscope",
  "description": "nginx log viewer",
  "packageManager": "bun@1.3.9",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "turbo run dev --filter=@logscope/web",
    "dev:api": "turbo run dev --filter=@logscope/api",
    "dev:shared": "turbo run dev --filter=@logscope/shared",
    "dev": "turbo dev",
    "test:web": "turbo run test --filter=@logscope/web",
    "test:api": "turbo run test --filter=@logscope/api",
    "test": "turbo test",
    "build": "turbo build",
    "lint": "biome lint --write",
    "lint:check": "biome lint",
    "format": "biome format --write",
    "format:check": "biome format",
    "check": "biome check --write",
    "check:check": "biome check",
    "release": "semantic-release",
    "prepare": "husky"
  },
  "author": "Dino Kupinic",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.4.7",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "semantic-release": "^25.0.3",
    "turbo": "^2.8.17"
  },
//  "lint-staged": {
//    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
//      "biome check --write ."
//    ]
//  }
}
